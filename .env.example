# Copiar a frontend/.env (valores del proyecto en supabase.com → Project Settings → API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Mock de identidad DNI (HU-02): 1 = usa datos de prueba en frontend/src/services/dni.js
# (la Edge Function de consulta aún no existe). Quitar o poner 0 cuando haya backend.
# VITE_MOCK_DNI=1

# --- Secrets de CI/CD (GitHub → Settings → Secrets and variables → Actions) ---
# SUPABASE_ACCESS_TOKEN=token personal de supabase.com (Account → Access Tokens)
# SUPABASE_PROJECT_REF=ref del proyecto (Project Settings → General → Reference ID)

# --- Secrets de Edge Functions (una vez, vía CLI; NO se commitean) ---
# supabase secrets set SCRALL_API_KEY=...
# Variables disponibles dentro de las funciones: SUPABASE_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY (inyectadas automáticamente) + las que se seteen con secrets set.
